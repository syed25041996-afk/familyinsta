{
  "name": "kinship-familygram",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Private, self-hosted, family-only Instagram-style social PWA",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "start": "node server.js",
    "preview": "vite preview --port 3000",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "worker": "tsx src/lib/server/worker-entry.ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@node-rs/argon2": "^2.0.2",
    "@simplewebauthn/server": "^10.0.1",
    "archiver": "^7.0.1",
    "cookie": "^1.0.2",
    "drizzle-orm": "^0.36.4",
    "exifreader": "^4.23.5",
    "file-type": "^19.6.0",
    "lucide-svelte": "^0.460.0",
    "pg": "^8.13.1",
    "sharp": "^0.33.5",
    "web-push": "^3.6.7",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@sveltejs/adapter-node": "^5.2.9",
    "@sveltejs/kit": "^2.8.2",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@types/archiver": "^6.0.2",
    "@types/cookie": "^0.6.0",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "@types/web-push": "^3.6.3",
    "@types/ws": "^8.5.13",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.28.1",
    "postcss": "^8.4.49",
    "svelte": "^5.2.7",
    "svelte-check": "^4.1.0",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  }
}
