{
  "name": "kinship-familygram",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted Home Lab Mobile API & Media Server for Kinship Android & iOS App",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "start": "node server.js",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "worker": "tsx src/lib/server/worker-entry.ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@node-rs/argon2": "^2.0.2",
    "archiver": "^7.0.1",
    "cookie": "^1.0.2",
    "drizzle-orm": "^0.36.4",
    "exifreader": "^4.23.5",
    "pg": "^8.13.1",
    "sharp": "^0.33.5",
    "web-push": "^3.6.7",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.2.9",
    "@sveltejs/kit": "^2.8.2",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@types/archiver": "^6.0.2",
    "@types/cookie": "^0.6.0",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "@types/web-push": "^3.6.3",
    "@types/ws": "^8.5.13",
    "drizzle-kit": "^0.28.1",
    "svelte": "^5.2.7",
    "svelte-check": "^4.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  }
}
