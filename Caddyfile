{
	email {$ACME_EMAIL:admin@example.com}
}

{$DOMAIN:localhost} {
	encode zstd gzip

	# Block all search engine crawlers & indexing
	header {
		X-Robots-Tag "noindex, nofollow, noarchive, nosnippet, noimageindex"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(self), camera=(self), microphone=(self), interest-cohort=()"
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		-Server
	}

	# Serve robots.txt directly disallowing everything
	respond /robots.txt 200 {
		body "User-agent: *
Disallow: /
"
		close
	}

	# Allow large chunked video uploads up to 2GB
	request_body {
		max_size 2GB
	}

	reverse_proxy app:3000 {
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}
}
