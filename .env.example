# ==============================================================================
# KINSHIP (FamilyGram) — Self-Hosted Family Social App Configuration
# ==============================================================================

# --- Core Server & Domain ---
NODE_ENV=production
PORT=3000
ORIGIN=https://family.example.com
PUBLIC_APP_NAME="Kinship Family"

# --- Database ---
# In Docker Compose, uses the postgres:16-alpine container:
# For local standalone dev/testing without Docker, use: pglite://./data/pglite
POSTGRES_USER=kinship
POSTGRES_PASSWORD=change_me_to_a_strong_db_password
POSTGRES_DB=kinship
DATABASE_URL=postgresql://kinship:change_me_to_a_strong_db_password@db:5432/kinship

# --- Security & Cryptography ---
# Generate with: openssl rand -hex 32
SESSION_SECRET=change_me_to_64_hex_chars_for_session_and_csrf_signing_0123456789
MEDIA_SIGNING_SECRET=change_me_to_64_hex_chars_for_hmac_signed_media_urls_9876543210

# --- Storage & Quotas (200 GB Proxmox VM Default) ---
MEDIA_ROOT=./data/media
BACKUP_ROOT=./data/backups
STORAGE_QUOTA_GB=180
MAX_IMAGE_SIZE_MB=50
MAX_VIDEO_SIZE_MB=2048

# --- WebAuthn Passkeys ---
RP_ID=family.example.com
RP_NAME="Kinship Family Vault"

# --- Web Push Notifications (VAPID) ---
# Generate with: npx web-push generate-vapid-keys (auto-generated on first boot if empty)
VAPID_SUBJECT=mailto:admin@family.example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Optional: Antivirus Hook (ClamAV) ---
CLAMAV_ENABLED=false
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# --- Access Mode Profiles (Docker Compose) ---
# 1. Public Domain via Caddy (Profile: public)
DOMAIN=family.example.com
ACME_EMAIL=admin@family.example.com

# 2. Cloudflare Tunnel (Profile: tunnel)
CLOUDFLARE_TUNNEL_TOKEN=

# 3. Private Mesh VPN via Tailscale (Profile: vpn)
TS_AUTHKEY=
TS_HOSTNAME=kinship-family

# --- Backup Retention Policy ---
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=6
