{
  "expo": {
    "name": "Kinship Family",
    "slug": "kinship-family",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "kinship",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.family.kinship",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Select photos and videos to share with your family.",
        "NSCameraUsageDescription": "Take photos and videos for family posts and 24-hour stories.",
        "NSFaceIDUsageDescription": "Use FaceID for quick passwordless sign-in to your family vault.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true,
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "package": "com.family.kinship",
      "usesCleartextTraffic": true,
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-image-picker",
      "expo-local-authentication",
      "expo-notifications"
    ]
  }
}
